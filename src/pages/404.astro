---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="没有这一页 · 谢兆明" description="这个地址没有对应的页面。" robots="noindex">
  <main id="main" tabindex="-1">
    <div class="wrap missing">
      <p class="eyebrow">404</p>
      <h1>没有这一页</h1>
      <p>链接可能已更换。可以从作品或首页继续。</p>
      <ul class="missing-links">
        <li><a href="/work/">作品</a></li>
        <li><a href="/">首页</a></li>
      </ul>
    </div>
  </main>
</BaseLayout>
