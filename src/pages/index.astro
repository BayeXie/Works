---
import BaseLayout from '../layouts/BaseLayout.astro';
import Frame from '../components/Frame.astro';
import WorkIndex from '../components/WorkIndex.astro';
import CaseBarber from '../components/CaseBarber.astro';
import CaseXingdong from '../components/CaseXingdong.astro';
import CaseAndu from '../components/CaseAndu.astro';
import { site } from '../data/site';
import { absolute, href } from '../lib/path';
import head from '../assets/images/head-mark.jpg';

const person = {
  '@type': 'Person',
  name: site.name,
  alternateName: site.nameEn,
  jobTitle: site.role,
  description: site.positioning,
  url: absolute('/'),
  alumniOf: {
    '@type': 'CollegeOrUniversity',
    name: '南京艺术学院',
  },
};
---

<BaseLayout title={`${site.name} · ${site.role}`} description={site.description} jsonLd={person}>
  <main id="main" tabindex="-1">
    <section class="opening" aria-labelledby="hero-title">
      <div class="opening-id">
        <h1 id="hero-title" class="opening-name">{site.name}</h1>
        <p class="opening-role">{site.role}</p>
      </div>
      <p class="opening-lede">
        以影像与视觉系统，<br />把一场战役从概念做到<br />可被触碰的接触点。
      </p>
    </section>

    <section class="head-still" aria-labelledby="mark-title">
      <h2 id="mark-title" class="sr-only">个人签名影像</h2>
      <Frame
        src={head}
        alt="黑色头像雕塑，颅顶裂开，云与虹彩从裂缝中涌出，碎片悬浮四周。个人签名影像。"
        widths={[480, 800, 1200]}
        sizes="100vw"
        focus="50% 38%"
        fill
      />
    </section>

    <section class="index-block edge" aria-labelledby="index-title">
      <h2 id="index-title" class="index-label">作品</h2>
      <nav aria-label="三场战役">
        <WorkIndex />
      </nav>
    </section>

    <CaseBarber linked />
    <CaseXingdong linked />
    <CaseAndu linked />

    <section class="close edge" aria-labelledby="close-title">
      <h2 id="close-title">合作</h2>
      <p>看完三场，如果方向对上了，可以写一封工作邀约。</p>
      <ul class="close-links">
        <li><a href={href('/about/')}>关于</a></li>
        <li><a href={href('/contact/')}>联系</a></li>
      </ul>
    </section>
  </main>
</BaseLayout>
