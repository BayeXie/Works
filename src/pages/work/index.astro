---
import BaseLayout from '../../layouts/BaseLayout.astro';
import WorkIndex from '../../components/WorkIndex.astro';

const description =
  '三场战役：开心麻花《疯狂理发店》、兴业银行「兴动全球」、短剧《暗渡》。每场只谈视觉怎样把概念变成接触点。';
---

<BaseLayout title="作品 · 谢兆明" description={description}>
  <main id="main" tabindex="-1">
    <header class="page-intro edge">
      <p class="meta">作品</p>
      <h1>三场战役</h1>
      <p class="lede">每场只谈一件事：视觉怎样把概念变成可以触碰的接触点。</p>
    </header>
    <div class="edge catalog">
      <WorkIndex lines asHeading />
    </div>
  </main>
</BaseLayout>
