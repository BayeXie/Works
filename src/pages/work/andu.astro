---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CaseAndu from '../../components/CaseAndu.astro';
import Pager from '../../components/Pager.astro';
import { href } from '../../lib/path';

const title = '暗渡 · 谢兆明';
const description =
  '短剧《暗渡》的海报与战役美术指导。主视觉承担传播；海报署有 9月24日上线，以及央视网、红果、抖音。';

const work = {
  '@type': 'CreativeWork',
  name: '暗渡',
  alternativeHeadline: 'The Hidden Gambit',
  inLanguage: 'zh-CN',
  creator: { '@type': 'Person', name: '谢兆明' },
  about: '短剧《暗渡》的海报与战役美术指导。',
};
---

<BaseLayout title={title} description={description} ogType="article" jsonLd={work}>
  <main id="main" tabindex="-1">
    <CaseAndu heading="h1" priority>
      <nav slot="crumb" class="crumb" aria-label="面包屑">
        <ol>
          <li><a href={href('/')}>首页</a> <span aria-hidden="true">/</span></li>
          <li><a href={href('/work/')}>作品</a> <span aria-hidden="true">/</span></li>
          <li aria-current="page">暗渡</li>
        </ol>
      </nav>
    </CaseAndu>
    <Pager slug="andu" />
  </main>
</BaseLayout>
