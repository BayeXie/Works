---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CaseXingdong from '../../components/CaseXingdong.astro';
import Pager from '../../components/Pager.astro';

const title = '兴动全球 · 谢兆明';
const description =
  '兴业银行「兴动全球」的战役视觉系统：行李箱主视觉、系列画面，以及同一体系中的 X+ 青年卡。不陈述银行数据或奖项。';

const work = {
  '@type': 'CreativeWork',
  name: '兴动全球',
  alternativeHeadline: '兴业银行 · 兴业生活',
  inLanguage: 'zh-CN',
  creator: { '@type': 'Person', name: '谢兆明' },
  about: '兴业银行「兴动全球」战役视觉系统，含主视觉、系列画面与 X+ 青年卡主视觉。',
};
---

<BaseLayout title={title} description={description} ogType="article" jsonLd={work}>
  <main id="main" tabindex="-1">
    <CaseXingdong heading="h1" priority>
      <nav slot="crumb" class="crumb" aria-label="面包屑">
        <ol>
          <li><a href="/">首页</a> <span aria-hidden="true">/</span></li>
          <li><a href="/work/">作品</a> <span aria-hidden="true">/</span></li>
          <li aria-current="page">兴动全球</li>
        </ol>
      </nav>
    </CaseXingdong>
    <Pager slug="xingdong-global" />
  </main>
</BaseLayout>
