---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CaseBarber from '../../components/CaseBarber.astro';
import Pager from '../../components/Pager.astro';
import { href } from '../../lib/path';

const title = '疯狂理发店 · 谢兆明';
const description =
  '开心麻花舞台剧《疯狂理发店》的战役与视觉指导：把角色收成可以单独传播的海报。剧目口碑记录为大众点评 4.9、猫眼 9.2。';

const work = {
  '@type': 'CreativeWork',
  name: '疯狂理发店',
  alternativeHeadline: '开心麻花舞台剧',
  inLanguage: 'zh-CN',
  creator: { '@type': 'Person', name: '谢兆明' },
  about: '舞台剧《疯狂理发店》的战役与视觉指导，覆盖主视觉与角色海报。',
};
---

<BaseLayout title={title} description={description} ogType="article" jsonLd={work}>
  <main id="main" tabindex="-1">
    <CaseBarber heading="h1" priority>
      <nav slot="crumb" class="crumb" aria-label="面包屑">
        <ol>
          <li><a href={href('/')}>首页</a> <span aria-hidden="true">/</span></li>
          <li><a href={href('/work/')}>作品</a> <span aria-hidden="true">/</span></li>
          <li aria-current="page">疯狂理发店</li>
        </ol>
      </nav>
    </CaseBarber>
    <Pager slug="crazy-barbershop" />
  </main>
</BaseLayout>
