---
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  widths: number[];
  sizes: string;
  priority?: boolean;
  caption?: string;
  class?: string;
}

const { src, alt, widths, sizes, priority = false, caption, class: className } = Astro.props;
const finalWidths = [...new Set([...widths.filter((width) => width < src.width), src.width])].sort(
  (a, b) => a - b,
);
---

<figure class:list={['frame', className]}>
  <Picture
    src={src}
    alt={alt}
    widths={finalWidths}
    sizes={sizes}
    formats={['avif', 'webp']}
    quality={82}
    loading={priority ? 'eager' : 'lazy'}
    decoding="async"
    fetchpriority={priority ? 'high' : 'auto'}
    style={`aspect-ratio: ${src.width} / ${src.height};`}
  />
  {caption && <figcaption>{caption}</figcaption>}
</figure>
