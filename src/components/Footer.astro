---
import { site } from '../data/site';
import { href } from '../lib/path';
---

<footer class="site-footer">
  <div class="wrap footer-grid">
    <div>
      <p class="footer-name">{site.name}</p>
      <p class="footer-en" lang="en">{site.nameEn}</p>
      <p>{site.role}</p>
      <p>© 2026</p>
    </div>
    <nav class="footer-nav" aria-label="页脚">
      <a href={href('/work/')}>作品</a>
      <a href={href('/about/')}>关于</a>
      <a href={href('/contact/')}>联系</a>
    </nav>
  </div>
</footer>
