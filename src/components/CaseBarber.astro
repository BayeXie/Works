---
import Frame from './Frame.astro';
import { href } from '../lib/path';
import tony from '../assets/images/barber-tony.jpg';
import asong from '../assets/images/barber-asong.jpg';

interface Props {
  heading?: 'h1' | 'h2';
  linked?: boolean;
  priority?: boolean;
}

const { heading = 'h2', linked = false, priority = false } = Astro.props;
const Tag = heading;
const Sub = heading === 'h1' ? 'h2' : 'h3';
---

<section class="case case-theatre" aria-labelledby="barber-title">
  <div class="case-opener">
    <slot name="crumb" />
    <p class="meta">
      <span class="num">01</span>
      <span>开心麻花 · 舞台剧</span>
    </p>
    <Tag id="barber-title" class="display-title display-title-play">
      {linked ? <a href={href('/work/crazy-barbershop/')}>疯狂理发店</a> : '疯狂理发店'}
    </Tag>
    <p class="case-kicker">战役与视觉指导 · 主视觉与角色海报</p>
  </div>

  <div class="stagger">
    <div class="stagger-a">
      <Frame
        src={tony}
        alt="《疯狂理发店》角色海报。冯康杰饰演 Tony，绿衫与背带短裤，手持超大金色剪刀，背景是红砖墙、理发椅和棋盘地面。"
        widths={[480, 800, 1100, 1400]}
        sizes="(min-width: 900px) 54vw, 92vw"
        focus="46% 22%"
        ratio="4 / 5"
        priority={priority}
      />
      <p class="cast">冯康杰 饰 Tony</p>
    </div>
    <div class="stagger-b">
      <Frame
        src={asong}
        alt="《疯狂理发店》角色海报。张淞饰演阿淞，灰色西装，手持巨大铜喇叭，背景是红墙、木砖与棋盘地面。"
        widths={[480, 800, 1100, 1400]}
        sizes="(min-width: 900px) 42vw, 78vw"
        focus="42% 28%"
        ratio="4 / 5"
      />
      <p class="cast">张淞 饰 阿淞</p>
    </div>
  </div>

  <div class="case-foot edge">
    <div class="scoreboard">
      <p>
        <strong>4.9</strong>
        <span>大众点评</span>
      </p>
      <p>
        <strong>9.2</strong>
        <span>猫眼</span>
      </p>
    </div>
    <div class="case-foot-copy">
      <div class="prose">
        <Sub>方向</Sub>
        <p>
          角色海报共用一套店面语法：棋盘地面、暖砖、铜框，以及大过日常的道具。剪刀和喇叭把人从演员变成招贴。两张海报可以分开传播，拼在一起仍是同一家店。
        </p>
        <p>名字竖排在铜边里，像戏单，也像贴在街角的卡司板。系统先于单张画面的花样。</p>
        <p>主视觉与角色海报。这场战役的判断，落在这些可以被贴上墙、被单独转发的画面上。</p>
      </div>
      <aside class="case-aside">
        <Sub>署名</Sub>
        <dl class="credits">
          <div>
            <dt>委托</dt>
            <dd>开心麻花</dd>
          </div>
          <div>
            <dt>项目</dt>
            <dd>舞台剧《疯狂理发店》</dd>
          </div>
          <div>
            <dt>职责</dt>
            <dd>战役与视觉指导</dd>
          </div>
          <div>
            <dt>范围</dt>
            <dd>主视觉与海报</dd>
          </div>
        </dl>
        <p class="fine">剧目对外可见的口碑记录。不另作奖项或票房陈述。</p>
      </aside>
    </div>
  </div>
  {
    linked && (
      <p class="edge case-more">
        <a class="more" href={href('/work/crazy-barbershop/')}>
          看这一场<span class="sr-only">：疯狂理发店</span>
        </a>
      </p>
    )
  }
</section>
